{
    "dev": {
        "app_function": "main.handler",
        "aws_region": "us-east-1",
        "exclude": [
            "boto3",
            "dateutil",
            "botocore",
            "s3transfer",
            "concurrent"
        ],
        "profile_name": "default",
        "project_name": "fastapi-project",
        "runtime": "python3.11",
        "s3_bucket": "zappa-fastapi-serverless",
        "events": [{
           "function": "service_handlers.opensearch_handler",
           "expression": "rate(1 hour)"
       }]
    }
}