# Environment (dev, staging, production, test)
ENVIRONMENT=dev

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fastapi_app
ASYNC_DATABASE_URL_EXT=postgresql+asyncpg://user:password@localhost:5432/fastapi_app

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
JWT_SECRET_KEY=your-jwt-secret-key-here
API_KEYS=api-key-1,api-key-2
ENCRYPTION_KEY=your-encryption-key-here

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# AWS (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Sentry (Optional)
SENTRY_DNS=

# AstraDB (Optional)
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=

# Logging
LOG_LEVEL=INFO
DEBUG=false
